{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ice-map",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "icemap.anthonynboyd.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
